{
  "name": "@turbo-notify/node-red-whatsapp",
  "version": "1.5.13",
  "description": "WhatsApp nodes for Node-RED: send text, pictures, documents and locations from your own number, and start a flow when a message arrives. Eighteen ready-to-import example flows.",
  "license": "MIT",
  "homepage": "https://docs.turbonotify.com/en/platforms/node-red/",
  "keywords": [
    "node-red",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "whatsapp-notifications",
    "whatsapp-alerts",
    "chatbot",
    "auto-reply",
    "notifications",
    "alerts",
    "automation",
    "iot",
    "home-automation",
    "turbo-notify",
    "turbonotify"
  ],
  "author": {
    "name": "Turbo Notify",
    "email": "support@turbonotify.com",
    "url": "https://turbonotify.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbo-notify/node-red-turbo-notify.git"
  },
  "bugs": {
    "url": "https://github.com/turbo-notify/node-red-turbo-notify/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "examples"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "turbo-notify-config": "dist/nodes/turbo-notify-config.js",
      "turbo-notify-send": "dist/nodes/turbo-notify-send.js",
      "turbo-notify-status": "dist/nodes/turbo-notify-status.js",
      "turbo-notify-events": "dist/nodes/turbo-notify-events.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-editor-files.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/node-red": "^1.3.5",
    "eslint": "^9.32.0",
    "jest": "^29.7.0",
    "node-red": "^4.1.17",
    "node-red-node-test-helper": "^0.3.6",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
