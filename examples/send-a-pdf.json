[
  {
    "id": "2ab2c3d4e5f60001",
    "type": "tab",
    "label": "Send a PDF",
    "disabled": false,
    "info": "Sends a document, such as an invoice, with a caption."
  },
  {
    "id": "2ab2c3d4e5f60002",
    "type": "comment",
    "z": "2ab2c3d4e5f60001",
    "name": "Setup",
    "info": "Before you run this flow: open the Turbo Notify account node, paste an API key and press Test. Your Turbo Notify account needs a WhatsApp number linked to it. The key needs the messages:send scope. Replace +12025550123 with the number that should receive the message. Replace the address in the change node with the public http or https address of your file. The file name is what the person sees. A public address is needed because Node-RED does not upload files.",
    "x": 200,
    "y": 40,
    "wires": []
  },
  {
    "id": "2ab2c3d4e5f60003",
    "type": "inject",
    "z": "2ab2c3d4e5f60001",
    "name": "Send the invoice",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "Your invoice for June",
    "payloadType": "str",
    "x": 200,
    "y": 140,
    "wires": [
      [
        "2ab2c3d4e5f60004"
      ]
    ]
  },
  {
    "id": "2ab2c3d4e5f60004",
    "type": "change",
    "z": "2ab2c3d4e5f60001",
    "name": "attach the file",
    "rules": [
      {
        "t": "set",
        "p": "media",
        "pt": "msg",
        "to": "{\"type\":\"document\",\"url\":\"https://your-site.example/files/invoice-june.pdf\",\"filename\":\"invoice-june.pdf\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 440,
    "y": 140,
    "wires": [
      [
        "2ab2c3d4e5f60005"
      ]
    ]
  },
  {
    "id": "2ab2c3d4e5f60005",
    "type": "turbo-notify-send",
    "z": "2ab2c3d4e5f60001",
    "name": "send document",
    "server": "tn0cfg0000000001",
    "to": "+12025550123",
    "number": "main",
    "x": 700,
    "y": 140,
    "wires": [
      [
        "2ab2c3d4e5f60006"
      ]
    ]
  },
  {
    "id": "2ab2c3d4e5f60006",
    "type": "debug",
    "z": "2ab2c3d4e5f60001",
    "name": "accepted",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 920,
    "y": 140,
    "wires": [
      []
    ]
  },
  {
    "id": "tn0cfg0000000001",
    "type": "turbo-notify-config",
